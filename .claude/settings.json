{
  "permissions": {
    "allow": ["Bash(gh pr merge:*)"],
    "deny": ["Bash(gh pr merge *--admin*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-never-rules.js\"" }
        ]
      }
    ]
  }
}
